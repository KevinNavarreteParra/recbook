# Copy to .env and run commands through `prun`, which resolves the pass://
# references from Proton Pass at launch. Adjust item names to your vault.
# The nightly unit resolves it through deploy/prun-or-run, and runs without
# it when there's no .env or it doesn't resolve.

# A Google Cloud API key restricted to the Books API, for `enrich`.
# Optional: without it, Google Books usually refuses and only Open Library
# is asked.
RECBOOK_GOOGLE_BOOKS_KEY=pass://Dev/Google Books API/api_key
